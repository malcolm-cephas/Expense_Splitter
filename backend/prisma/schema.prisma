// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                 String           @id @default(auto()) @map("_id") @db.ObjectId
  auth0Id            String?          @unique @map("auth0id")
  email              String           @unique
  name               String?
  familyName         String?          @map("family_name")
  currencyPreference String?          @map("currency_preference")
  
  groupMembers       GroupMember[]
  createdGroups      Group[]          @relation("GroupCreator")
  expensePayments    ExpensePayment[]
  expenseSplits      ExpenseSplit[]
  paidExpenses       Expense[]
  settlementsPaid    Settlement[]     @relation("PaidBy")
  settlementsReceived Settlement[]    @relation("PaidTo")

  @@map("users")
}

model Group {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  name                  String?
  description           String?
  budget                Float?
  budgetCurrency        String?   @map("budget_currency")
  familyGroupingEnabled Boolean   @default(false) @map("family_grouping_enabled")
  
  createdBy             User?     @relation("GroupCreator", fields: [createdById], references: [id])
  createdById           String?   @map("created_by_id") @db.ObjectId
  
  membersList           GroupMember[]
  expenses              Expense[]
  settlements           Settlement[]

  @@map("groups")
}

model GroupMember {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  groupId String @map("group_id") @db.ObjectId
  userId  String @map("user_id") @db.ObjectId
  
  group   Group  @relation(fields: [groupId], references: [id])
  user    User   @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@map("group_members")
}

model Expense {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  description    String?
  amount         Float
  currency       String?
  category       String?
  paymentMode    String?          @map("payment_mode")
  splitType      String?          @map("split_type")
  receiptPath    String?          @map("receipt_path")
  expenseDate    DateTime?        @map("expense_date")
  createdAt      DateTime         @map("created_at")
  
  group          Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId        String           @map("group_id") @db.ObjectId
  
  paidBy         User?            @relation(fields: [paidById], references: [id])
  paidById       String?          @map("paid_by_id") @db.ObjectId
  
  payments       ExpensePayment[]
  splits         ExpenseSplit[]

  @@map("expenses")
}

model ExpensePayment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  amount    Float
  
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId String   @map("expense_id") @db.ObjectId
  
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @map("user_id") @db.ObjectId

  @@map("expense_payments")
}

model ExpenseSplit {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  owedAmount  Float    @map("owed_amount")
  paidAmount  Float?   @default(0) @map("paid_amount")
  isPaid      Boolean  @map("is_paid")
  
  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId   String   @map("expense_id") @db.ObjectId
  
  user        User     @relation(fields: [userId], references: [id])
  userId      String   @map("user_id") @db.ObjectId

  @@map("expense_splits")
}

model Settlement {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  amount    Float
  createdAt DateTime @map("created_at")
  status    String
  
  group     Group    @relation(fields: [groupId], references: [id])
  groupId   String   @map("group_id") @db.ObjectId
  
  paidBy    User     @relation("PaidBy", fields: [paidById], references: [id])
  paidById  String   @map("paid_by_id") @db.ObjectId
  
  paidTo    User     @relation("PaidTo", fields: [paidToId], references: [id])
  paidToId  String   @map("paid_to_id") @db.ObjectId

  @@map("settlements")
}
