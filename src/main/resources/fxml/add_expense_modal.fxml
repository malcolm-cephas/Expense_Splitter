<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.malcolm.expensesplitter.controllers.AddExpenseController"
            prefWidth="500.0" prefHeight="650.0" styleClass="background">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <top>
        <Label text="Add an Expense" styleClass="title-2" BorderPane.alignment="CENTER"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-padding: 0;">
            <VBox spacing="15.0">
                <padding>
                    <Insets top="20" right="10" bottom="20" left="10"/>
                </padding>
                <GridPane hgap="10" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints minWidth="100"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    
                    <Label text="Description:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="descriptionField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    
                    <Label text="Amount:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <TextField fx:id="amountField" HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="currencyComboBox" prefWidth="100"/>
                    </HBox>
                    
                    <Label text="Paid by:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <ComboBox fx:id="payerComboBox" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <VBox fx:id="multiplePayersContainer" spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="3" managed="false" visible="false"/>

                    <Label text="Payment Mode:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <ComboBox fx:id="paymentModeComboBox" GridPane.columnIndex="1" GridPane.rowIndex="4" maxWidth="Infinity"/>

                    <Label text="Category:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                    <ComboBox fx:id="categoryComboBox" GridPane.columnIndex="1" GridPane.rowIndex="5" maxWidth="Infinity"/>

                    <Label text="Date:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                    <DatePicker fx:id="expenseDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="6" maxWidth="Infinity"/>

                    <Label text="Receipt (Bill):" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="7">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button text="Attach Bill..." onAction="#handleChooseReceipt"/>
                            <Button fx:id="removeReceiptButton" text="Remove" onAction="#handleRemoveReceipt" styleClass="flat" visible="false" managed="false"/>
                            <Label fx:id="receiptPathLabel" text="No bill attached" style="-fx-text-fill: gray;"/>
                        </HBox>
                        <ImageView fx:id="receiptPreview" fitWidth="120" fitHeight="120" preserveRatio="true" visible="false" managed="false"/>
                    </VBox>
                </GridPane>

                <Separator/>
                <Label text="Split Options" styleClass="title-4"/>
                <TabPane fx:id="splitTypeTabPane" minHeight="300" tabClosingPolicy="UNAVAILABLE">
                    <tabs>
                        <Tab text="Equal (=)">
                            <VBox alignment="CENTER_LEFT" spacing="10">
                                <padding><Insets top="20" bottom="20"/></padding>
                                <Label text="Select members involved in this expense:" styleClass="title-4"/>
                                <VBox fx:id="membersCheckboxContainer" spacing="5"/>
                            </VBox>
                        </Tab>
                        <Tab text="Exact Amount">
                            <VBox alignment="TOP_LEFT" spacing="10">
                                <padding><Insets top="20" bottom="20"/></padding>
                                <Label text="Enter exact amount for each member:" styleClass="title-4"/>
                                <VBox fx:id="exactAmountContainer" spacing="5"/>
                            </VBox>
                        </Tab>
                        <Tab text="Percentages (%)">
                            <VBox alignment="TOP_LEFT" spacing="10">
                                <padding><Insets top="20" bottom="20"/></padding>
                                <Label text="Enter percentage for each member (Total 100%):" styleClass="title-4"/>
                                <VBox fx:id="percentageContainer" spacing="5"/>
                            </VBox>
                        </Tab>
                        <Tab text="Shares (x)">
                            <VBox alignment="TOP_LEFT" spacing="10">
                                <padding><Insets top="20" bottom="20"/></padding>
                                <Label text="Enter number of shares for each member:" styleClass="title-4"/>
                                <VBox fx:id="sharesContainer" spacing="5"/>
                            </VBox>
                        </Tab>
                    </tabs>
                </TabPane>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="10.0" alignment="CENTER_RIGHT" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="20"/>
            </padding>
            <Button text="Cancel" onAction="#handleCancel"/>
            <Button fx:id="saveAndNewButton" text="Save &amp; Add Another" onAction="#handleSaveAndNew" styleClass="flat"/>
            <Button text="Save Expense" onAction="#handleSave" styleClass="accent"/>
        </HBox>
    </bottom>
</BorderPane>
