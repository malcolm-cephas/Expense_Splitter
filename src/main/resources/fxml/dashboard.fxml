<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.malcolm.expensesplitter.controllers.DashboardController"
            prefHeight="768.0" prefWidth="1024.0" styleClass="background">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="20.0" style="-fx-border-color: transparent transparent lightgray transparent; -fx-border-width: 1;">
            <padding>
                <Insets top="10.0" right="20.0" bottom="10.0" left="20.0"/>
            </padding>
            <Label text="💸 Expense Splitter" styleClass="title-3, accent"/>
            
            <javafx.scene.layout.Region HBox.hgrow="ALWAYS" />
            
            <HBox alignment="CENTER_RIGHT" spacing="15.0">
                <javafx.scene.control.ToggleButton fx:id="themeToggleButton" 
                    text="🌙 Dark" onAction="#handleThemeToggle" prefWidth="90.0"/>
                
                <Label text="Default Currency: " styleClass="text-muted"/>
                <TextField fx:id="currencySearchField" promptText="Search currency (e.g. INR)" prefWidth="150.0"/>
            </HBox>
        </HBox>
    </top>

    <!-- Sidebar for Groups -->
    <left>
        <VBox prefWidth="250.0" spacing="15.0" style="-fx-border-color: transparent lightgray transparent transparent; -fx-border-width: 1;">
            <padding>
                <Insets top="20.0" right="10.0" bottom="20.0" left="20.0"/>
            </padding>
            <Label text="Groups" styleClass="title-2"/>
            <ListView fx:id="groupListView" VBox.vgrow="ALWAYS" styleClass="edge-to-edge"/>
            
            <VBox spacing="10.0">
                <Label text="Create New Group" styleClass="title-4"/>
                <VBox spacing="10.0">
                    <TextField fx:id="newGroupNameField" promptText="Group Name"/>
                    <TextField fx:id="newGroupBudgetField" promptText="Initial Budget (Optional)"/>
                    <Button text="Create" onAction="#onCreateGroup" styleClass="accent" prefWidth="250.0"/>
                </VBox>
            </VBox>

            <VBox spacing="10.0">
                <Label text="Tools" styleClass="title-4"/>
                <Button text="📂 Import Group Backup" onAction="#handleImportGroup" prefWidth="210.0"/>
            </VBox>
        </VBox>
    </left>

    <!-- Main Content Area (Dynamic) -->
    <center>
        <VBox fx:id="mainContentArea" alignment="CENTER" spacing="20.0">
            <padding>
                <Insets top="10.0" right="30.0" bottom="30.0" left="30.0"/>
            </padding>
            <Label text="Select a group from the sidebar" styleClass="text-muted, title-3"/>
        </VBox>
    </center>

</BorderPane>
