# --- SHARED SECRETS ---

# Auth0 (From Auth0 Dashboard)
AUTH0_ISSUER_URI=https://YOUR_DOMAIN.auth0.com/
AUTH0_AUDIENCE=https://expensesplitter.api
VITE_AUTH0_DOMAIN=YOUR_DOMAIN.auth0.com
VITE_AUTH0_CLIENT_ID=YOUR_CLIENT_ID
VITE_AUTH0_AUDIENCE=https://expensesplitter.api

# Database (Cloud - e.g., Supabase or PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://db.example.com:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_password
SPRING_JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Database (Alternative - MongoDB Atlas)
# If switching to Mongo, these would be used instead
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname

# App Settings
SPRING_PROFILES_ACTIVE=prod
VITE_API_BASE_URL=http://your-app-domain.com
